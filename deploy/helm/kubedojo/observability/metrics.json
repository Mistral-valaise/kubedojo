{
  "comment": "Metrics that dashboards and alert rules may query. tools/obslint checks every query against this file. 'kubedojo' is generated from the instruments: UPDATE_CATALOG=1 go test ./internal/telemetry/",
  "external": [
    {
      "name": "http_server_request_duration_seconds",
      "type": "histogram",
      "where": [
        "shared",
        "local",
        "lgtm",
        "kubernetes"
      ],
      "source": "otelhttp, the HTTP instrumentation of the API"
    },
    {
      "prefix": "otelcol_",
      "where": [
        "lgtm"
      ],
      "source": "the OpenTelemetry Collector inside grafana/otel-lgtm"
    },
    {
      "prefix": "traces_",
      "where": [
        "lgtm"
      ],
      "source": "Tempo's metrics generator inside grafana/otel-lgtm"
    },
    {
      "prefix": "container_",
      "where": [
        "kubernetes"
      ],
      "source": "kubelet/cAdvisor"
    },
    {
      "prefix": "kube_pod_",
      "where": [
        "kubernetes"
      ],
      "source": "kube-state-metrics"
    }
  ],
  "kubedojo": [
    {
      "name": "gen_ai_client_inference_duration_seconds",
      "type": "histogram",
      "labels": [
        "error_type",
        "gen_ai_operation_name",
        "gen_ai_provider_name",
        "gen_ai_request_model",
        "gen_ai_response_model",
        "server_address",
        "server_port"
      ]
    },
    {
      "name": "gen_ai_client_inference_operation_input_tokens",
      "type": "histogram",
      "labels": [
        "error_type",
        "gen_ai_operation_name",
        "gen_ai_provider_name",
        "gen_ai_request_model",
        "gen_ai_response_model",
        "server_address",
        "server_port"
      ]
    },
    {
      "name": "gen_ai_client_inference_operation_output_tokens",
      "type": "histogram",
      "labels": [
        "error_type",
        "gen_ai_operation_name",
        "gen_ai_provider_name",
        "gen_ai_request_model",
        "gen_ai_response_model",
        "server_address",
        "server_port"
      ]
    },
    {
      "name": "gen_ai_client_inference_time_to_first_chunk_seconds",
      "type": "histogram",
      "labels": [
        "gen_ai_operation_name",
        "gen_ai_provider_name",
        "gen_ai_request_model",
        "gen_ai_response_model",
        "server_address",
        "server_port"
      ]
    },
    {
      "name": "gen_ai_client_inference_usage_cache_read_input_tokens_total",
      "type": "counter",
      "labels": [
        "gen_ai_operation_name",
        "gen_ai_provider_name",
        "gen_ai_request_model",
        "gen_ai_response_model",
        "gen_ai_token_modality",
        "server_address",
        "server_port"
      ]
    },
    {
      "name": "gen_ai_client_inference_usage_cache_write_input_tokens_total",
      "type": "counter",
      "labels": [
        "gen_ai_operation_name",
        "gen_ai_provider_name",
        "gen_ai_request_model",
        "gen_ai_response_model",
        "gen_ai_token_modality",
        "server_address",
        "server_port"
      ]
    },
    {
      "name": "gen_ai_client_inference_usage_input_tokens_total",
      "type": "counter",
      "labels": [
        "gen_ai_operation_name",
        "gen_ai_provider_name",
        "gen_ai_request_model",
        "gen_ai_response_model",
        "gen_ai_token_modality",
        "server_address",
        "server_port"
      ]
    },
    {
      "name": "gen_ai_client_inference_usage_output_tokens_total",
      "type": "counter",
      "labels": [
        "gen_ai_operation_name",
        "gen_ai_provider_name",
        "gen_ai_request_model",
        "gen_ai_response_model",
        "gen_ai_token_modality",
        "server_address",
        "server_port"
      ]
    },
    {
      "name": "kubedojo_assistant_context_duration_seconds",
      "type": "histogram",
      "labels": [
        "cached",
        "track"
      ]
    },
    {
      "name": "kubedojo_assistant_requests_total",
      "type": "counter",
      "labels": [
        "mode",
        "phase",
        "provider",
        "result",
        "track"
      ]
    },
    {
      "name": "kubedojo_check_runs_total",
      "type": "counter",
      "labels": [
        "mode",
        "question",
        "result",
        "track"
      ]
    },
    {
      "name": "kubedojo_docker_memory_limit_bytes",
      "type": "gauge",
      "labels": []
    },
    {
      "name": "kubedojo_exam_score_percent",
      "type": "histogram",
      "labels": [
        "track"
      ]
    },
    {
      "name": "kubedojo_exams_finished_total",
      "type": "counter",
      "labels": [
        "result",
        "track"
      ]
    },
    {
      "name": "kubedojo_http_requests_rejected_total",
      "type": "counter",
      "labels": [
        "reason"
      ]
    },
    {
      "name": "kubedojo_question_rating",
      "type": "histogram",
      "labels": [
        "question",
        "track"
      ]
    },
    {
      "name": "kubedojo_question_score_ratio",
      "type": "histogram",
      "labels": [
        "mode",
        "track"
      ]
    },
    {
      "name": "kubedojo_sandbox_containers",
      "type": "gauge",
      "labels": [
        "role"
      ]
    },
    {
      "name": "kubedojo_sandbox_cpu_usage",
      "type": "gauge",
      "labels": [
        "role"
      ]
    },
    {
      "name": "kubedojo_sandbox_memory_usage_bytes",
      "type": "gauge",
      "labels": [
        "role"
      ]
    },
    {
      "name": "kubedojo_sandbox_provision_duration_seconds",
      "type": "histogram",
      "labels": [
        "mode",
        "result",
        "track"
      ]
    },
    {
      "name": "kubedojo_sandboxes_active",
      "type": "gauge",
      "labels": []
    },
    {
      "name": "kubedojo_sandboxes_limit",
      "type": "gauge",
      "labels": []
    },
    {
      "name": "kubedojo_sessions_active",
      "type": "gauge",
      "labels": [
        "mode"
      ]
    },
    {
      "name": "kubedojo_store_operation_duration_seconds",
      "type": "histogram",
      "labels": [
        "operation"
      ]
    },
    {
      "name": "kubedojo_terminal_connections",
      "type": "gauge",
      "labels": []
    },
    {
      "name": "kubedojo_terminal_session_duration_seconds",
      "type": "histogram",
      "labels": []
    }
  ],
  "localOnly": [
    "kubedojo_sandbox_containers",
    "kubedojo_sandbox_cpu_usage",
    "kubedojo_sandbox_memory_usage_bytes",
    "kubedojo_docker_memory_limit_bytes"
  ]
}
